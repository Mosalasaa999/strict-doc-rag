<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:orientation="vertical">

    <!-- Sleek Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_veritas_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VeritasVault"
                android:textColor="#F8FAFC"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillVaultStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="9dp"
                android:paddingVertical="2dp"
                android:text="Vault: 0 ready • Tap to manage"
                android:textColor="#FBBF24"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaved"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_dark"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Saved"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_dark"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="API"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Chat Stream Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/tvEmptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:alpha="0.85"
                android:src="@drawable/ic_veritas_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Strict Closed-Domain Vault"
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="Every question starts strictly inside your documents.\nTap Vault below to add files or pick specific contracts."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Thumb-Friendly Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btnVaultAttach"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_dark"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Vault"
            android:textAllCaps="false"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_rounded"
            android:hint="Ask your documents..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="42dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#10B981"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="Ask"
            android:textAllCaps="false"
            android:textColor="#042F2E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>