<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1120"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="StrictDoc RAG"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaved"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1E293B"
            android:text="Saved"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#1E293B"
            android:text="API URL"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUploadDoc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#059669"
            android:text="+ Add Document"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRefreshDocs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1E293B"
            android:text="Sync"
            android:textColor="#CBD5E1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCorpusStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Corpus: 0 synced | 0 queued"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#131E32"
        android:hint="Ask strictly from your documents..."
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="12dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B" />

    <Button
        android:id="@+id/btnAsk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2563EB"
        android:text="Ask in Strict Mode (Docs Only)"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1E293B"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="STRICT MODE: DOCS ONLY"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveAnswer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#334155"
            android:text="Save"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#131E32"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAnswerOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.25"
            android:text="Add a PDF, Markdown, or TXT file above, then ask a question."
            android:textColor="#E2E8F0"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnApproveExternal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#7C3AED"
        android:text="Approve Aligned External Lookup (Web + AI)"
        android:textColor="#FFFFFF"
        android:visibility="gone" />
</LinearLayout>