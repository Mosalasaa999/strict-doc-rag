<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">

    <!-- User Bubble -->
    <TextView
        android:id="@+id/tvUserQuery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_user"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#F8FAFC"
        android:textSize="14sp" />

    <!-- Assistant Response Card -->
    <LinearLayout
        android:id="@+id/cardAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_assistant"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTurnBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STRICT MODE"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveTurn"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill_dark"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Layer 1: Document Claims -->
        <LinearLayout
            android:id="@+id/llDocSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDocClaims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llCitationChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Layer 2: Approved Live Web -->
        <LinearLayout
            android:id="@+id/llWebSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0F1F3A"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE WEB • ALIGNED TO DOCS"
                android:textColor="#60A5FA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#DBEAFE"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/llWebLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Layer 3: Approved AI Knowledge -->
        <LinearLayout
            android:id="@+id/llAiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1E1436"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI KNOWLEDGE • ALIGNED TO DOCS"
                android:textColor="#C084FC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#EDE9FE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Approval Gate Button -->
        <Button
            android:id="@+id/btnUnlockExternal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#6D28D9"
            android:text="Approve Aligned Web + AI Lookup"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>